# Copy to ~/apps/bar-jukebox/.env on the VM (chmod 600). Never commit the real file.
BASE_URL=https://<QUEUEPLAY_HOST>
DATABASE_URL=postgresql://queueplay:<password>@postgres:5432/queueplay

# Copy these values unchanged from Railway → queueplay-jukebox → production → Variables
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SUPER_ADMIN_KEY=
SALT=                      # MUST be identical, or every venue password and session breaks
SUPPORT_EMAIL=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
